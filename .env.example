# =============================================================================
# Plantilla de Variables de Entorno y Secretos Externalizados — CircleGuard (US-05 / SCRUM-44)
#
# Uso en desarrollo local:
#   cp .env.example .env
#   # Reemplace los marcadores <CHANGE_ME_*> por valores locales antes de ejecutar:
#   docker compose --env-file .env -f docker-compose.dev.yml up -d
#
# Uso en entornos compartidos (dev, stage, prod):
#   Los secretos reales NUNCA se almacenan en Git. Se inyectan desde el almacén
#   de credenciales de Jenkins mediante infra/bootstrap/inject-jenkins-secrets.sh
#   o se generan con permisos 0600 en /opt/circleguard/<env>/.env durante el bootstrap.
# =============================================================================

# --- Identificación del Ambiente y Versión SemVer ---
TARGET_ENV=dev
APP_VERSION=0.1.0
# Tag inmutable de las imágenes propias en deploy/compose (US-08). SemVer estricto, nunca latest.
# Si se omite, docker-compose.<env>.yml usa APP_VERSION.
IMAGE_TAG=0.1.0

# --- Registro Privado de Contenedores (Nexus / Registry) ---
REGISTRY_URL=18.117.90.15:5000
REGISTRY_INSECURE=true
REGISTRY_USER=<CHANGE_ME_REGISTRY_USER>
REGISTRY_PASSWORD=<CHANGE_ME_REGISTRY_PASSWORD>

# --- PostgreSQL 16 (Bóveda de identidades, formularios, auth y promoción) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=circleguard
POSTGRES_USER=circleguard_app
POSTGRES_PASSWORD=<CHANGE_ME_POSTGRES_PASSWORD>

# --- Neo4j 5.26 (Grafo temporal de contactos de 14 días) ---
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<CHANGE_ME_NEO4J_PASSWORD>

# --- Apache Kafka 7.6 y Zookeeper ---
ZOOKEEPER_PORT=2181
KAFKA_PORT=9092
KAFKA_ADVERTISED_HOST=localhost

# --- Redis 7.2 (Caché distribuida de validación de QR) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<CHANGE_ME_REDIS_PASSWORD>

# --- OpenLDAP (Directorio institucional universitario) ---
LDAP_PORT=389
LDAPS_PORT=636
LDAP_ORGANISATION=CircleGuard
LDAP_DOMAIN=circleguard.edu
LDAP_BASE_DN=dc=circleguard,dc=edu
LDAP_ADMIN_PASSWORD=<CHANGE_ME_LDAP_ADMIN_PASSWORD>

# --- Secretos Criptográficos de Microservicios (JWT, QR y Vault) ---
JWT_SECRET=<CHANGE_ME_JWT_SECRET_MIN_32_CHARS>
QR_SECRET=<CHANGE_ME_QR_SECRET_MIN_32_CHARS>
VAULT_SECRET=<CHANGE_ME_VAULT_SECRET_HEX_64_CHARS>
VAULT_SALT=<CHANGE_ME_VAULT_SALT_HEX>
VAULT_HASH_SALT=<CHANGE_ME_VAULT_HASH_SALT>

# --- Puertos de Microservicios Núcleo y Cliente Web ---
AUTH_SERVICE_PORT=8180
IDENTITY_SERVICE_PORT=8083
PROMOTION_SERVICE_PORT=8088
FORM_SERVICE_PORT=8086
GATEWAY_SERVICE_PORT=8087
WEB_CLIENT_PORT=8080
# Host o IP pública con la que el navegador alcanza los servicios (cliente web, US-08)
PUBLIC_HOST=localhost
