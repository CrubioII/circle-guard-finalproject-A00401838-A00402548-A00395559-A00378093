# =============================================================================
# Plantilla de variables de entorno para el plano de control CI/CD (US-04 / SCRUM-16)
# Copiado de forma idempotente hacia infra/bootstrap/.env.ci por bootstrap-ci.sh
# =============================================================================

# Host o IP pública/privada de la instancia EC2 donde corre el plano de control
CI_PUBLIC_HOST=localhost

# --- Jenkins (Servidor y agente CI/CD) ---
JENKINS_HTTP_PORT=8080
JENKINS_AGENT_PORT=50000
JENKINS_URL=http://localhost:8080/
JENKINS_JAVA_OPTS="-Djenkins.install.runSetupWizard=false -Dhudson.model.DirectoryBrowserSupport.CSP= -Xms512m -Xmx1024m"
DOCKER_GID=999

# --- Jenkins: cuentas y aprobación de prod (US-31) ---
# Contraseñas de las cuentas de jenkins/ci/jenkins.yaml. Déjalas vacías: bootstrap-ci.sh genera
# una aleatoria para cada una que falte y nunca sobrescribe las existentes. Llegan a Jenkins como
# secretos de Docker Compose (/run/secrets), no como variables de entorno.
JENKINS_ADMIN_PASSWORD=
JENKINS_PWD_JRUBIO=
JENKINS_PWD_ECUELLAR=
JENKINS_PWD_SCASTILLO=
JENKINS_PWD_JPORDONEZ=
JENKINS_PWD_DOCENTE=
# IDs de usuario que pueden aprobar releases a prod, separados por comas (vacío = prod omitido).
CG_PROD_APPROVERS=jrubio,jpordonez
CG_PROD_APPROVAL_TIMEOUT_MIN=60
# Hosts de los ambientes (US-13) y registro Docker
CG_DEV_HOST=52.15.213.209
CG_STAGE_HOST=3.17.163.44
CG_PROD_HOST=3.19.74.9
CG_REGISTRY_URL=52.14.6.11:5000

# --- SonarQube (Análisis estático y Quality Gate) ---
SONARQUBE_PORT=9000
SONAR_HOST_URL=http://sonarqube:9000
SONAR_DB_NAME=sonarqube
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=change_me_sonar_db_password
SONAR_SEARCH_OPTS="-Xms512m -Xmx512m"
SONAR_WEB_OPTS="-Xms256m -Xmx512m"
SONAR_CE_OPTS="-Xms256m -Xmx512m"

# --- Sonatype Nexus 3 (Registro de artefactos y Docker Registry privado) ---
NEXUS_HTTP_PORT=8081
NEXUS_DOCKER_REGISTRY_PORT=5000
NEXUS_URL=http://nexus:8081
DOCKER_REGISTRY_URL=localhost:5000
NEXUS_JVM_OPTS="-Xms512m -Xmx768m -XX:MaxDirectMemorySize=1024m -Djava.util.prefs.userRoot=/nexus-data/javaprefs"
