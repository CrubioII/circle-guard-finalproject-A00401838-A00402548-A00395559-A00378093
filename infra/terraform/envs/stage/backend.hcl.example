# init-backend.sh genera backend.hcl (ignorado por Git) con el ID de la cuenta.
# A mano: copia este archivo como backend.hcl y reemplaza <ID_CUENTA>.
#   terraform init -backend-config=backend.hcl
bucket       = "circleguard-terraform-state-<ID_CUENTA>"
key          = "envs/stage/platform.tfstate"
region       = "us-east-2"
use_lockfile = true
encrypt      = true
