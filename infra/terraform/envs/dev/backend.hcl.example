# Copia este archivo como backend.hcl (ignorado por Git) y reemplaza <ID_CUENTA>.
# El bucket de estado y la tabla de bloqueo los crea la historia del backend remoto.
#   terraform init -backend-config=backend.hcl
bucket         = "circleguard-terraform-state-<ID_CUENTA>"
key            = "envs/dev/platform.tfstate"
region         = "us-east-2"
dynamodb_table = "circleguard-terraform-locks"
encrypt        = true
