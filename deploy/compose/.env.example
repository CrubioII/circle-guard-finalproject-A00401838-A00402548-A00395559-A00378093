# =============================================================================
# CircleGuard - Variables de entorno para orquestación Docker Compose (US-08)
# Ambientes: dev, stage, prod
# =============================================================================

# Registro de artefactos y versión semántica inmutable (US-11 y US-12)
REGISTRY_URL=52.14.6.11:5000
REGISTRY_NAMESPACE=circleguard
IMAGE_TAG=0.1.0

# Base de datos relacional PostgreSQL (auth-service, identity-service)
POSTGRES_USER=circleguard_admin
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=circleguard
POSTGRES_PORT=5432

# Base de datos de grafos Neo4j (promotion-service)
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Mensajería Kafka y Zookeeper (form-service, promotion-service)
ZOOKEEPER_PORT=2181
KAFKA_PORT=9092
KAFKA_ADVERTISED_HOST=kafka

# Caché y tokens temporales Redis (gateway-service, promotion-service)
REDIS_PASSWORD=your_redis_password_here
REDIS_PORT=6379

# Directorio de identidades OpenLDAP (auth-service)
LDAP_ORGANISATION=CircleGuard
LDAP_DOMAIN=circleguard.edu
LDAP_ADMIN_PASSWORD=your_ldap_admin_password_here
LDAP_PORT=389
LDAPS_PORT=636

# Secretos de aplicación (criptografía, tokens JWT y QR)
JWT_SECRET=your_jwt_secret_min_32_characters_here
QR_SIGNING_SECRET=your_qr_signing_secret_min_32_characters_here
IDENTITY_VAULT_SALT=your_identity_vault_salt_here
AES_ENCRYPTION_KEY=your_base64_aes_encryption_key_here

# Puertos de microservicios y cliente web
AUTH_SERVICE_PORT=8180
IDENTITY_SERVICE_PORT=8083
PROMOTION_SERVICE_PORT=8082
FORM_SERVICE_PORT=8085
GATEWAY_SERVICE_PORT=8084
WEB_CLIENT_PORT=8080
